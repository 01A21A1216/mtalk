# Optional cloud sign-in for grown-up accounts (Firebase Authentication).
#
# Leave this file out entirely and MTalk works exactly as before: accounts are
# local to the tablet and sign-in is by PIN. Add the key below and the login
# screen also offers email + password, matched to an account that already
# exists on the tablet.
#
# Where to get it: Firebase console -> Project settings -> General ->
# "Your apps" -> Web app -> apiKey. Then enable Authentication -> Sign-in
# method -> Email/Password.
#
# Copy this file to .env (which is git-ignored) before filling it in.

VITE_FIREBASE_API_KEY=

# Firebase project id (same console page as the key). Only needed to read
# subscription entitlement from Firestore at sign-in.
VITE_FIREBASE_PROJECT_ID=

# Your hosted payment page (Razorpay/Stripe). Parents subscribe there, never
# inside the app. Leave empty until the page exists.
VITE_SUBSCRIBE_URL=

# Endpoint that returns a generated picture for a tile, enabling "✨ Make one"
# in the tile editor. This must be YOUR OWN proxy (e.g. a Cloud Function) that
# holds the image-provider key server-side — never the provider key itself,
# which anyone could extract from the APK and spend.
#   POST { prompt, name, category }  ->  { image: "data:image/..." } or { url }
VITE_IMAGE_GEN_URL=
